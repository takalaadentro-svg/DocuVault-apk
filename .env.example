# ==============================================================================
# DocuVault — Environment Variables Example
# Copy this file to .env and adjust variables as required for deployment.
# ==============================================================================

PROJECT_NAME="DocuVault Backend"
VERSION="1.0.0"

# Cryptographic Keys (Spring Security JWT HMAC-SHA256)
JWT_SECRET="DocuVaultUltraSecureSpringSecurityJwtSecretKey2026AcademicProjectEngineeringMatrixXYZ"

# ==============================================================================
# Database Configuration (MongoDB Atlas / Local)
# ==============================================================================
# Cloud MongoDB Atlas Connection URI:
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/docuvault_db?retryWrites=true&w=majority"
# Or local MongoDB:
# MONGODB_URI="mongodb://localhost:27017/docuvault_db"

# ==============================================================================
# Cloud Object Storage Configuration (Cloudflare R2 / Local Partition)
# ==============================================================================
STORAGE_TYPE="r2" # Set to "r2" to use Cloudflare R2, or "local" for disk
STORAGE_DIR="./storage_uploads"

# Cloudflare R2 Credentials (Get from Cloudflare Dashboard -> R2 -> Manage R2 API Tokens)
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="docuvault-storage"
# Optional Public / Custom Domain (e.g., https://pub-xxx.r2.dev or https://assets.yourdomain.com)
R2_PUBLIC_URL="""

# ==============================================================================
# Python EasyOCR REST Microservice URL
# ==============================================================================
OCR_SERVICE_URL="http://localhost:5001/extract-ocr"

# ==============================================================================
# Mail & Push Alerting Settings (Spring Mail & FCM)
# ==============================================================================
MAIL_HOST="smtp.gmail.com"
MAIL_PORT=587
MAIL_USERNAME=""
MAIL_PASSWORD=""

# Upload Limits & CORS
MAX_UPLOAD_SIZE_MB=50
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:8080"]
